extends layouts/page.pug

block content
  .row.justify-content-center
    .col-lg-8.col-xl-7

      .mb-5.pt-2
        h1.display-6.fw-bold.mb-3 Добро пожаловать в Учебный центр
        p.lead.text-muted.mb-4 Осваивайте современные технологии с опытными преподавателями. Практические курсы, реальные проекты, поддержка на каждом шагу.

        if !visited
          .alert.alert-warning.mb-4(role='alert')
            | Это сообщение показывается только при первом посещении. Очистите cookies, чтобы увидеть его снова.

        .d-flex.flex-wrap.gap-2
          a.btn.btn-primary(href='/courses') Смотреть курсы
          a.btn.btn-outline-secondary(href='/users/new') Начать обучение

      hr(style='border-color: var(--uc-border);')

      .row.g-4.mt-1
        .col-md-6
          .card.h-100
            .card-body.p-4
              h5.card-title.fw-semibold.mb-2 О нас
              p.card-text.text-muted.small.mb-3 Мы предоставляем качественное обучение по программированию. Наши курсы помогут освоить современные технологии и стать востребованным специалистом.
              a.text-decoration-none.small.fw-semibold(href='/courses' style='color: var(--uc-primary);') Наши курсы &rarr;

        .col-md-6
          .card.h-100
            .card-body.p-4
              h5.card-title.fw-semibold.mb-2 Наши преимущества
              ul.list-unstyled.mb-0.small.text-muted
                li.py-1 Опытные преподаватели
                li.py-1 Практические задания
                li.py-1 Гибкий график обучения
                li.py-1 Поддержка после курса
