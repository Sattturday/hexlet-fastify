html(lang='ru')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Учебный центр — курсы по программированию
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    style.
      :root {
        --uc-primary: #4f46e5;
        --uc-primary-dark: #3730a3;
        --uc-text: #1e293b;
        --uc-muted: #64748b;
        --uc-surface: #f8fafc;
        --uc-border: #e2e8f0;
      }
      body {
        color: var(--uc-text);
        background-color: var(--uc-surface);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      }
      .navbar {
        border-bottom: 1px solid var(--uc-border);
      }
      .navbar-brand {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: -0.3px;
        color: var(--uc-text) !important;
      }
      .navbar-brand span {
        color: var(--uc-primary);
      }
      .nav-link {
        font-weight: 500;
        color: var(--uc-muted) !important;
        transition: color .15s ease;
      }
      .nav-link:hover {
        color: var(--uc-text) !important;
      }
      .btn-primary, .btn-primary:focus {
        background-color: var(--uc-primary);
        border-color: var(--uc-primary);
      }
      .btn-primary:hover {
        background-color: var(--uc-primary-dark);
        border-color: var(--uc-primary-dark);
      }
      .btn-outline-primary {
        color: var(--uc-primary);
        border-color: var(--uc-primary);
      }
      .btn-outline-primary:hover {
        background-color: var(--uc-primary);
        border-color: var(--uc-primary);
      }
      .card {
        border: 1px solid var(--uc-border);
        border-radius: .5rem;
      }
      .card-hover {
        transition: box-shadow .2s ease;
      }
      .card-hover:hover {
        box-shadow: 0 4px 12px rgba(0,0,0,.07);
      }
      .form-control:focus, .form-select:focus {
        border-color: var(--uc-primary);
        box-shadow: 0 0 0 .2rem rgba(79,70,229,.12);
      }
      .alert {
        border-radius: .4rem;
      }
      .avatar-initials {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e0e7ff;
        color: var(--uc-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: .95rem;
        flex-shrink: 0;
      }

  body.d-flex.flex-column.min-vh-100
    nav.navbar.navbar-expand-lg.bg-white
      .container
        a.navbar-brand(href='/')
          span Учебный
          | &thinsp;центр
        button.navbar-toggler.border-0(type='button' data-bs-toggle='collapse' data-bs-target='#navbarMain' aria-controls='navbarMain' aria-expanded='false' aria-label='Переключить навигацию')
          span.navbar-toggler-icon
        #navbarMain.collapse.navbar-collapse
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link.px-3(href='/') Главная
            li.nav-item
              a.nav-link.px-3(href='/courses') Курсы
            li.nav-item
              a.nav-link.px-3(href='/users') Пользователи
          .d-flex.align-items-center.gap-2.ms-lg-2
            if currentUser
              .d-flex.align-items-center.gap-3
                span.text-muted.small #{currentUser.name}
                form(action=route('deleteSession') method='post' class='d-inline m-0')
                  button.btn.btn-outline-secondary.btn-sm(type='submit') Выйти
            else
              a.btn.btn-outline-primary.btn-sm(href=route('newSession')) Войти
              a.btn.btn-primary.btn-sm(href=route('newUser')) Регистрация

    main.flex-grow-1.py-5
      .container
        if flash && flash.success
          each msg in flash.success
            .alert.alert-success.alert-dismissible.fade.show(role='alert')
              = msg
              button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Закрыть')
        if flash && flash.error
          each msg in flash.error
            .alert.alert-danger.alert-dismissible.fade.show(role='alert')
              = msg
              button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Закрыть')
        block content

    footer.bg-white(style='border-top: 1px solid var(--uc-border);')
      .container.py-4
        .d-flex.flex-column.flex-md-row.align-items-md-center.justify-content-between.gap-2
          span.fw-semibold.text-muted.small
            span(style='color: var(--uc-primary);') Учебный
            |  центр
          .d-flex.align-items-center.gap-4
            a.text-muted.text-decoration-none.small(href='https://github.com/Sattturday' target='_blank') GitHub
            span.text-muted.small &copy; 2024

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
