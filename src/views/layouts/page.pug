html
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Учебный сайт по курсам
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: #333;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      
      .header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
        padding: 15px 0;
      }
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        width: 100%;
      }
      
      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .logo a {
        color: #2c3e50;
        text-decoration: none;
        font-size: 24px;
        font-weight: 600;
      }
      
      .nav ul {
        list-style: none;
        display: flex;
        gap: 30px;
      }
      
      .nav a {
        color: #495057;
        text-decoration: none;
        font-weight: 500;
      }
      
      .nav a:hover {
        color: #0066cc;
      }
      
      .login {
        color: #2c3e50;
        text-decoration: none;
        font-weight: 700;
      }
      
      .login:hover {
        color: #0066cc;
      }

      .main {
        flex: 1;
        padding: 30px 0;
      }
      
      .footer {
        background-color: #2c3e50;
        color: #ecf0f1;
        padding: 30px 0;
        margin-top: 50px;
      }
      
      .footer-content {
        text-align: center;
      }
      
      .footer a {
        color: #ecf0f1;
        text-decoration: none;
        border-bottom: 1px dotted #ecf0f1;
      }
      
      .footer a:hover {
        color: white;
        border-bottom: 1px solid white;
      }

  body
    header.header
      .container
        .header-content
          h1.logo
            a(href='/') Учебный центр
          nav.nav
            ul
              li
                a(href='/') Главная
              li
                a(href='/courses') Курсы
              li
                a(href='/users') Пользователи
          a.login(href="/session/new") Войти
    main.main
      .container
        block content

    footer.footer
      .container
        .footer-content
          p © 2024 Учебный центр. Все права защищены.
          p 
            a(href='https://github.com/Sattturday') Мой GitHub профиль