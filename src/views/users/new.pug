extends ../layouts/page.pug

block content
  .row.justify-content-center
    .col-sm-10.col-md-8.col-lg-6

      .mb-4
        h1.h3.fw-bold.mb-1 Создание аккаунта
        p.text-muted.small.mb-0 Заполните все поля для регистрации

      if error
        .alert.alert-danger(role='alert')
          strong Ошибка:
          |  #{error.message}

      .card
        .card-body.p-4.p-md-5

          form(action='/users' method='post' autocomplete='off')
            .mb-3
              label.form-label.fw-semibold.small(for='name') Полное имя
              input(
                type='text'
                id='name'
                name='name'
                value=name
                placeholder='Иван Иванов'
                autocomplete='off'
                class=`form-control${error && error.field === 'name' ? ' is-invalid' : ''}`
              )
              if error && error.field === 'name'
                .invalid-feedback #{error.message}

            .mb-3
              label.form-label.fw-semibold.small(for='email') Email адрес
              input(
                type='email'
                id='email'
                name='email'
                value=email
                placeholder='ivan@example.com'
                autocomplete='off'
                class=`form-control${error && error.field === 'email' ? ' is-invalid' : ''}`
              )
              if error && error.field === 'email'
                .invalid-feedback #{error.message}

            .mb-3
              label.form-label.fw-semibold.small(for='password') Пароль
              input(
                type='password'
                id='password'
                name='password'
                placeholder='••••••••'
                autocomplete='new-password'
                class=`form-control${error && error.field === 'password' ? ' is-invalid' : ''}`
              )
              if error && error.field === 'password'
                .invalid-feedback #{error.message}
              else
                .form-text Минимум 5 символов

            .mb-4
              label.form-label.fw-semibold.small(for='passwordConfirmation') Подтверждение пароля
              input(
                type='password'
                id='passwordConfirmation'
                name='passwordConfirmation'
                placeholder='••••••••'
                autocomplete='new-password'
                class=`form-control${error && error.field === 'passwordConfirmation' ? ' is-invalid' : ''}`
              )
              if error && error.field === 'passwordConfirmation'
                .invalid-feedback #{error.message}

            .d-flex.gap-2
              button.btn.btn-primary.flex-grow-1(type='submit') Создать аккаунт
              a.btn.btn-outline-secondary(href='/users') Отмена
