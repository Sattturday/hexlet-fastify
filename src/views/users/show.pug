extends ../layouts/page.pug

block content
  .row.justify-content-center
    .col-sm-10.col-md-8.col-lg-7

      nav.mb-4(aria-label='breadcrumb')
        ol.breadcrumb.mb-0
          li.breadcrumb-item
            a.text-decoration-none(href='/users' style='color: var(--uc-primary);') Пользователи
          li.breadcrumb-item.active(aria-current='page') Профиль

      .card.mb-4
        .card-body.p-4.p-md-5
          .d-flex.align-items-center.gap-4.mb-4
            .avatar-initials(style='width: 56px; height: 56px; font-size: 1.3rem;')
              | #{user.name ? user.name.charAt(0).toUpperCase() : 'U'}
            div
              h1.h3.fw-bold.mb-0 #{user.name}
              if user.isAdmin
                span.badge.bg-light.text-dark.border.small.mt-1 Администратор

          dl.row.mb-0
            dt.col-sm-4.text-muted.small.fw-semibold.py-2 Email
            dd.col-sm-8.py-2(style='border-bottom: 1px solid var(--uc-border);')
              a(href=`mailto:${user.email}` style='color: var(--uc-primary);') #{user.email}
            dt.col-sm-4.text-muted.small.fw-semibold.py-2 ID пользователя
            dd.col-sm-8.py-2
              code.text-muted.small #{user.id}

      .d-flex.gap-2
        a.btn.btn-primary(href=`/users/${user.id}/edit`) Редактировать
        a.btn.btn-outline-secondary(href='/users') К списку
