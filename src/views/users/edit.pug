extends ../layouts/page.pug

block content
  .row.justify-content-center
    .col-sm-10.col-md-8.col-lg-6

      nav.mb-4(aria-label='breadcrumb')
        ol.breadcrumb.mb-0
          li.breadcrumb-item
            a.text-decoration-none(href='/users' style='color: var(--uc-primary);') Пользователи
          li.breadcrumb-item
            a.text-decoration-none(href=`/users/${user.id}` style='color: var(--uc-primary);') Профиль
          li.breadcrumb-item.active(aria-current='page') Редактирование

      .mb-4
        h1.h3.fw-bold.mb-1 Редактировать профиль
        p.text-muted.small.mb-0 ID пользователя:&nbsp;
          code.text-muted #{user.id}

      if error
        .alert.alert-danger(role='alert')
          strong Ошибка:
          |  #{error.message}

      .card
        .card-body.p-4.p-md-5

          form(action=`/users/${user.id}?_method=PATCH` method='post')
            .mb-3
              label.form-label.fw-semibold.small(for='name') Полное имя
              input(
                type='text'
                id='name'
                name='name'
                value=user.name
                placeholder='Иван Иванов'
                class=`form-control${error && error.field === 'name' ? ' is-invalid' : ''}`
              )
              if error && error.field === 'name'
                .invalid-feedback #{error.message}

            .mb-4
              label.form-label.fw-semibold.small(for='email') Email адрес
              input(
                type='email'
                id='email'
                name='email'
                value=user.email
                placeholder='ivan@example.com'
                class=`form-control${error && error.field === 'email' ? ' is-invalid' : ''}`
              )
              if error && error.field === 'email'
                .invalid-feedback #{error.message}
              else
                .form-text Изменение email потребует подтверждения

            .d-flex.gap-2
              button.btn.btn-primary.flex-grow-1(type='submit') Сохранить изменения
              a.btn.btn-outline-secondary(href=`/users/${user.id}`) Отмена
