extends ../layouts/page.pug

block content
  style.
    .form-container {
      max-width: 500px;
      margin: 0 auto;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    
    h1 {
      color: #333;
      border-bottom: 2px solid #f0f0f0;
      padding-bottom: 10px;
      margin-bottom: 25px;
    }
    
    .error-message {
      background-color: #ffebee;
      color: #c62828;
      padding: 12px 15px;
      border-radius: 4px;
      border-left: 4px solid #f44336;
      margin-bottom: 20px;
      font-size: 0.95em;
    }
    
    .form-group {
      margin-bottom: 20px;
    }
    
    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #444;
      font-size: 0.95em;
    }
    
    input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 1em;
      transition: border-color 0.3s, box-shadow 0.3s;
      box-sizing: border-box;
    }
    
    input:focus {
      outline: none;
      border-color: #2196F3;
      box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.1);
    }
    
    input.error {
      border-color: #f44336;
    }
    
    .readonly-hint {
      background-color: #f9f9f9;
      padding: 8px 12px;
      border-radius: 4px;
      margin-top: 5px;
      font-size: 0.85em;
      color: #666;
      border: 1px dashed #ccc;
    }
    
    .button-group {
      margin-top: 30px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    
    .save-button {
      background-color: #2196F3;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 4px;
      font-size: 1em;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    
    .save-button:hover {
      background-color: #1976D2;
    }
    
    .cancel-link {
      color: #666;
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 4px;
      transition: background-color 0.3s;
    }
    
    .cancel-link:hover {
      background-color: #f5f5f5;
    }
    
    .delete-link {
      margin-left: auto;
      color: #f44336;
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 4px;
      transition: background-color 0.3s;
    }
    
    .delete-link:hover {
      background-color: #ffebee;
    }
    
    .user-info {
      background-color: #f5f5f5;
      padding: 15px;
      border-radius: 4px;
      margin-bottom: 25px;
      border-left: 4px solid #2196F3;
    }
    
    .user-info-item {
      margin: 5px 0;
      color: #555;
    }
    
    .user-info-label {
      font-weight: 600;
      color: #333;
      min-width: 60px;
      display: inline-block;
    }

  .form-container
    h1 Edit user

    if error
      .error-message
        strong Error: 
        = error.message

    // Информация о пользователе для контекста
    .user-info
      .user-info-item
        span.user-info-label ID:
        span  #{user.id}

    form(action=`/users/${user.id}?_method=PATCH` method="post")
      .form-group
        label(for="name") Full name
        input(
          type="text" 
          id="name"
          name="name" 
          value=user.name
          placeholder="John Doe"
          class=error && error.field === 'name' ? 'error' : ''
        )

      .form-group
        label(for="email") Email address
        input(
          type="email" 
          id="email"
          name="email" 
          value=user.email
          placeholder="john@example.com"
          class=error && error.field === 'email' ? 'error' : ''
        )
        .readonly-hint Changing email will require verification

      .button-group
        button.save-button(type="submit") Save changes
        a.cancel-link(href=`/users/${user.id}`) Cancel
