extends ../layouts/page.pug

block content
  style.
    .users-container {
      max-width: 800px;
      margin: 0 auto;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    
    h1 {
      color: #333;
      border-bottom: 2px solid #f0f0f0;
      padding-bottom: 10px;
    }
    
    .add-button {
      display: inline-block;
      background-color: #4CAF50;
      color: white;
      padding: 8px 16px;
      text-decoration: none;
      border-radius: 4px;
      margin-bottom: 20px;
      transition: background-color 0.3s;
    }
    
    .add-button:hover {
      background-color: #45a049;
    }
    
    .empty-message {
      color: #666;
      font-style: italic;
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 4px;
      text-align: center;
    }
    
    .users-list {
      list-style: none;
      padding: 0;
    }
    
    .user-item {
      background-color: #f9f9f9;
      border: 1px solid #ddd;
      border-radius: 4px;
      padding: 12px 15px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    
    .user-info {
      flex: 1;
      min-width: 200px;
    }
    
    .user-name {
      font-weight: 600;
      color: #333;
    }
    
    .user-email {
      color: #666;
      font-size: 0.9em;
    }
    
    .user-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    
    .action-link {
      color: #2196F3;
      text-decoration: none;
      padding: 4px 8px;
      border-radius: 3px;
      transition: background-color 0.3s;
    }
    
    .action-link:hover {
      background-color: #e3f2fd;
    }
    
    .delete-form {
      margin: 0;
    }
    
    .delete-button {
      background-color: #f44336;
      color: white;
      border: none;
      padding: 4px 12px;
      border-radius: 3px;
      cursor: pointer;
      font-size: 0.9em;
      transition: background-color 0.3s;
    }
    
    .delete-button:hover {
      background-color: #da190b;
    }

  .users-container
    if flash && flash.success
      each msg in flash.success
        .alert.alert-success.alert-dismissible(role="alert" style="padding: 12px 20px; margin-bottom: 16px; border: 1px solid #c3e6cb; background-color: #d4edda; color: #155724; border-radius: 4px;")
          = msg
    if flash && flash.error
      each msg in flash.error
        .alert.alert-danger.alert-dismissible(role="alert" style="padding: 12px 20px; margin-bottom: 16px; border: 1px solid #f5c6cb; background-color: #f8d7da; color: #721c24; border-radius: 4px;")
          = msg
    h1 Users

    a.add-button(href="/users/new") + Add user

    if users.length === 0
      p.empty-message No users yet

    ul.users-list
      each user in users
        li.user-item
          .user-info
            span.user-name #{user.name}
            span.user-email  (#{user.email})
          .user-actions
            a.action-link(href=`/users/${user.id}`) View
            a.action-link(href=`/users/${user.id}/edit`) Edit
            form.delete-form(action=`/users/${user.id}?_method=DELETE` method="post")
              button.delete-button(type="submit") Delete