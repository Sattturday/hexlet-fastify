extends ../layouts/page.pug

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.fw-bold.mb-0 Пользователи
      p.text-muted.small.mb-0 Все зарегистрированные участники
    a.btn.btn-primary(href='/users/new') Добавить

  if users.length === 0
    .card.text-center.py-5
      p.text-muted.mb-0 Пользователей пока нет
  else
    .card
      .list-group.list-group-flush
        each user in users
          .list-group-item.d-flex.align-items-center.flex-wrap.gap-3.py-3.px-4
            .avatar-initials
              | #{user.name ? user.name.charAt(0).toUpperCase() : 'U'}
            .flex-grow-1.min-width-0
              div.fw-semibold.text-truncate #{user.name}
              div.text-muted.small.text-truncate #{user.email}
            .d-flex.gap-2.flex-shrink-0
              a.btn.btn-sm.btn-outline-secondary(href=`/users/${user.id}`) Просмотр
              a.btn.btn-sm.btn-outline-secondary(href=`/users/${user.id}/edit`) Изменить
              form(action=`/users/${user.id}?_method=DELETE` method='post' class='d-inline m-0')
                button.btn.btn-sm.btn-outline-danger(type='submit') Удалить
