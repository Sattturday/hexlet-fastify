extends ../layouts/page.pug

block content
  .row.justify-content-center
    .col-sm-10.col-md-7.col-lg-5

      .mb-4
        h1.h3.fw-bold.mb-1 Вход в систему
        p.text-muted.small.mb-0 Введите данные вашего аккаунта

      .card
        .card-body.p-4.p-md-5

          form(action='/session' method='post')
            .mb-3
              label.form-label.fw-semibold.small(for='email') Email
              input.form-control(
                type='email'
                id='email'
                name='email'
                placeholder='example@mail.com'
                autocomplete='email'
              )

            .mb-4
              label.form-label.fw-semibold.small(for='password') Пароль
              input.form-control(
                type='password'
                id='password'
                name='password'
                placeholder='••••••••'
                autocomplete='current-password'
              )

            .d-grid
              button.btn.btn-primary(type='submit') Войти

          hr.my-4
          p.text-center.text-muted.small.mb-0
            | Ещё нет аккаунта?&nbsp;
            a.fw-semibold(href='/users/new' style='color: var(--uc-primary);') Зарегистрироваться
