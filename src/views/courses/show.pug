extends ../layouts/page.pug

block content
  style.
    .course-card {
      background-color: #f9f9f9;
      padding: 25px;
      border-radius: 8px;
      margin: 20px 0;
    }
    
    .course-description {
      line-height: 1.6;
      color: #444;
    }
    
    .course-meta {
      color: #666;
      font-size: 0.9em;
      padding-top: 15px;
      margin-top: 15px;
      border-top: 1px solid #ddd;
    }
    
    .actions {
      margin-top: 25px;
    }
    
    .btn {
      display: inline-block;
      padding: 8px 16px;
      text-decoration: none;
      border-radius: 4px;
      margin-right: 8px;
      font-size: 14px;
      line-height: 1.5;
      border: none;
      cursor: pointer;
      box-sizing: border-box;
      vertical-align: middle;
      font-family: inherit;
    }
    
    .btn-list {
      background-color: #0066cc;
      color: white;
    }
    
    .btn-edit {
      background-color: #ffc107;
      color: #333;
    }
    
    .btn-delete {
      background-color: #dc3545;
      color: white;
    }
    
    .not-found {
      color: #666;
      font-style: italic;
    }

  if course
    h2 #{course.title}

    .course-card
      p.course-description
        strong Описание:
        |  #{course.description}

      .course-meta
        strong ID курса:
        |  #{course.id}

    .actions
      a.btn.btn-list(href=route('courses')) К списку курсов
      a.btn.btn-edit(href=route('editCourse', { id: course.id })) Редактировать
      form(action=`/courses/${course.id}` method='post' style='display:inline')
        button.btn.btn-delete(type='submit') Удалить
  else
    h2 Курс не найден
    p.not-found
      a(href=route('courses')) Вернуться к списку