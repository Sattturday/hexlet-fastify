extends ../layouts/page.pug

block content
  if course
    nav.mb-4(aria-label='breadcrumb')
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a.text-decoration-none(href=route('courses') style='color: var(--uc-primary);') Курсы
        li.breadcrumb-item.active(aria-current='page') #{course.title}

    .card.mb-4
      .card-body.p-4.p-md-5
        h1.h2.fw-bold.mb-3 #{course.title}

        h5.fw-semibold.mb-2.text-muted.small.text-uppercase.letter-spacing Описание
        p.text-muted.lh-lg #{course.description}

        hr(style='border-color: var(--uc-border);')

        p.text-muted.small.mb-0
          | ID курса:&nbsp;
          code #{course.id}

    .d-flex.flex-wrap.gap-2
      a.btn.btn-outline-secondary(href=route('courses')) Все курсы
      a.btn.btn-primary(href=route('editCourse', { id: course.id })) Редактировать
      form(action=`/courses/${course.id}/delete` method='post' class='d-inline m-0')
        button.btn.btn-outline-danger(type='submit') Удалить

  else
    .card.text-center.py-5
      h2.h4.mb-2 Курс не найден
      p.text-muted.mb-3 Запрашиваемый курс не существует или был удалён.
      a.btn.btn-outline-secondary(href=route('courses')) Вернуться к списку
