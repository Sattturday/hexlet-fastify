extends ../layouts/page.pug

block content
  style.
    .form-container {
      max-width: 600px;
    }
    
    .error-message {
      color: #dc3545;
      background-color: #f8d7da;
      padding: 10px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
    
    .form-group {
      margin-bottom: 15px;
    }
    
    label {
      font-weight: 600;
      display: block;
      margin-bottom: 5px;
    }
    
    input, textarea {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 14px;
      box-sizing: border-box;
    }
    
    textarea {
      min-height: 150px;
      font-family: inherit;
    }
    
    .button-group {
      margin-top: 20px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    
    .save-btn {
      background-color: #0066cc;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
    }
    
    .save-btn:hover {
      background-color: #0052a3;
    }
    
    .cancel-link {
      color: #666;
      text-decoration: none;
    }
    
    .cancel-link:hover {
      text-decoration: underline;
    }

  h1 Edit course

  if error
    .error-message= error.message

  form(action=`/courses/${course.id}` method="post")
    .form-group
      label Title
      input(type="text" name="title" value=course.title)

    .form-group
      label Description
      textarea(name="description")= course.description

    .button-group
      button.save-btn(type="submit") Save
      a.cancel-link(href=`/courses/${course.id}`) Cancel