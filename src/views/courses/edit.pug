extends ../layouts/page.pug

block content
  .row.justify-content-center
    .col-sm-10.col-md-8.col-lg-7

      nav.mb-4(aria-label='breadcrumb')
        ol.breadcrumb.mb-0
          li.breadcrumb-item
            a.text-decoration-none(href='/courses' style='color: var(--uc-primary);') Курсы
          li.breadcrumb-item
            a.text-decoration-none(href=`/courses/${course.id}` style='color: var(--uc-primary);') #{course.title}
          li.breadcrumb-item.active(aria-current='page') Редактирование

      .mb-4
        h1.h3.fw-bold.mb-1 Редактировать курс
        p.text-muted.small.mb-0 Внесите изменения и сохраните

      if error
        .alert.alert-danger(role='alert') #{error.message}

      .card
        .card-body.p-4.p-md-5

          form(action=`/courses/${course.id}` method='post')
            .mb-3
              label.form-label.fw-semibold.small(for='title') Название курса
              input.form-control(
                type='text'
                id='title'
                name='title'
                value=course.title
                placeholder='Название курса'
              )

            .mb-4
              label.form-label.fw-semibold.small(for='description') Описание
              textarea.form-control(
                id='description'
                name='description'
                rows='5'
                placeholder='Описание курса...'
                style='resize: vertical;'
              )= course.description

            .d-flex.gap-2
              button.btn.btn-primary.flex-grow-1(type='submit') Сохранить изменения
              a.btn.btn-outline-secondary(href=`/courses/${course.id}`) Отмена
