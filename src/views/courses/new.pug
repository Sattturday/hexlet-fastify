extends ../layouts/page.pug

block content
  style.
    .form-container {
      max-width: 600px;
    }
    
    .error-message {
      color: #dc3545;
      background-color: #f8d7da;
      padding: 10px;
      border-radius: 4px;
      margin-bottom: 20px;
    }
    
    .form-group {
      margin-bottom: 15px;
    }
    
    label {
      font-weight: 600;
      display: block;
      margin-bottom: 5px;
    }
    
    input, textarea {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 14px;
    }
    
    textarea {
      min-height: 100px;
      font-family: inherit;
    }
    
    button {
      background-color: #0066cc;
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
    }
    
    button:hover {
      background-color: #0052a3;
    }

  h1 New course

  if flash && flash.error
    each msg in flash.error
      .alert.alert-danger(role="alert" style="padding: 12px 20px; margin-bottom: 16px; border: 1px solid #f5c6cb; background-color: #f8d7da; color: #721c24; border-radius: 4px;")
        = msg

  if error
    .error-message= error.message

  form(action=route('createCourse') method="post")
    .form-group
      label Title
      input(type="text" name="title" value=title)

    .form-group
      label Description
      textarea(name="description")= description

    button(type="submit") Create course