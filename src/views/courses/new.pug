extends ../layouts/page.pug

block content
  h1 New course

  if error
    p(style="color:red")= error.message

  form(action="/courses" method="post")
    div
      label Title
      input(type="text" name="title" value=title)

    div
      label Description
      textarea(name="description")= description

    input(type="submit" value="Create course")