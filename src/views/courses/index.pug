extends ../layouts/page.pug

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    div
      h1.h3.fw-bold.mb-0 Курсы
      p.text-muted.small.mb-0 Все доступные программы обучения
    a.btn.btn-primary(href=route('newCourse')) Создать курс

  form.mb-4(role='form' method='GET' action='/courses')
    .input-group
      span.input-group-text.bg-white(style='border-color: var(--uc-border);')
        i.bi.bi-search.text-muted(style='font-size: .85rem;')
      input.form-control(
        type='search'
        name='term'
        value=term
        placeholder='Поиск по названию или описанию...'
        style='border-left: none; border-color: var(--uc-border);'
      )
      button.btn.btn-primary(type='submit') Найти

  if courses && courses.length
    .row.g-3
      each course in courses
        .col-12.col-md-6
          .card.card-hover.h-100
            .card-body.p-4
              h3.card-title.h5.fw-semibold.mb-2
                a.text-decoration-none(href=route('course', { id: course.id }) style='color: var(--uc-text);') #{course.title}
              p.card-text.text-muted.small.mb-0 #{course.description}
            .card-footer.bg-transparent.px-4.pb-3.pt-0(style='border-color: var(--uc-border);')
              .d-flex.gap-2
                a.btn.btn-sm.btn-outline-primary.flex-grow-1.text-center(href=route('course', { id: course.id })) Подробнее
                a.btn.btn-sm.btn-outline-secondary(href=route('editCourse', { id: course.id })) Изменить
                form(action=`/courses/${course.id}/delete` method='post' class='d-inline m-0')
                  button.btn.btn-sm.btn-outline-danger(type='submit') Удалить
  else
    .card.text-center.py-5
      p.text-muted.mb-1 Курсы не найдены
      if term
        p.text-muted.small.mb-0
          | По запросу «#{term}» ничего не найдено.&nbsp;
          a(href='/courses' style='color: var(--uc-primary);') Сбросить поиск
      else
        p.text-muted.small.mb-0 Добавьте первый курс, нажав кнопку выше
