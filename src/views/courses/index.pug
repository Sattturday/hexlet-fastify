extends ../layouts/page.pug

block content
  style.
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    
    .create-btn {
      display: inline-block;
      background-color: #4CAF50;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 5px;
    }
    
    .search-form {
      margin-bottom: 20px;
    }
    
    .search-form input {
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px 0 0 4px;
      font-size: 14px;
    }
    
    .search-form button {
      padding: 8px 16px;
      background-color: #0066cc;
      color: white;
      border: none;
      border-radius: 0 4px 4px 0;
      cursor: pointer;
      font-size: 14px;
      margin-left: -4px;
    }
    
    .courses-grid {
      display: grid;
      gap: 20px;
      margin-top: 20px;
    }
    
    .course-card {
      border: 1px solid #ddd;
      padding: 20px;
      border-radius: 8px;
    }
    
    .course-title {
      margin: 0 0 10px 0;
    }
    
    .course-title a {
      color: #0066cc;
      text-decoration: none;
    }
    
    .course-title a:hover {
      text-decoration: underline;
    }
    
    .course-description {
      color: #555;
      line-height: 1.6;
      margin: 10px 0;
    }
    
    .course-actions {
      margin-top: 15px;
    }
    
    .course-actions a {
      margin-right: 15px;
      color: #0066cc;
      text-decoration: none;
    }
    
    .course-actions a:hover {
      text-decoration: underline;
    }
    
    .delete-btn {
      background: none;
      border: none;
      color: #dc3545;
      cursor: pointer;
      padding: 0;
      font-size: 14px;
    }
    
    .delete-btn:hover {
      text-decoration: underline;
    }
    
    .empty-message {
      color: #666;
      font-style: italic;
      margin-top: 20px;
    }

  if flash && flash.success
    each msg in flash.success
      .alert.alert-success(role="alert" style="padding: 12px 20px; margin-bottom: 16px; border: 1px solid #c3e6cb; background-color: #d4edda; color: #155724; border-radius: 4px;")
        = msg
  if flash && flash.error
    each msg in flash.error
      .alert.alert-danger(role="alert" style="padding: 12px 20px; margin-bottom: 16px; border: 1px solid #f5c6cb; background-color: #f8d7da; color: #721c24; border-radius: 4px;")
        = msg

  .header
    h2 Список курсов
    a.create-btn(href=route('newCourse')) Создать новый курс

  form.search-form(role='form' method='GET' action='/courses')
    input(type='search' name='term' value=term placeholder='Поиск...')
    button(type='submit') Найти

  if courses && courses.length
    .courses-grid
      each course in courses
        .course-card
          h3.course-title
            a(href=route('course', { id: course.id })) #{course.title}

          p.course-description #{course.description}

          .course-actions
            a(href=route('editCourse', { id: course.id })) Редактировать
            form(action=`/courses/${course.id}` method='post' style='display:inline')
              button.delete-btn(type='submit') Удалить
  else
    p.empty-message Курсы пока не добавлены